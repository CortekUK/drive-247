# Loaded by `next dev` only — never by `next build`, so no deployment reads it.
#
# The tenant served when the address carries no tenant subdomain, i.e. plain
# http://localhost:3000. That is where the portal and the super admin send
# Northwind's "Open Booking Site" in development (apps/portal/src/lib/booking-url.ts,
# apps/admin/lib/booking-site-url.ts), so it must be Northwind. Other tenants
# still resolve by subdomain ({slug}.localhost:3000), and in production
# src/lib/constants.ts ignores this value entirely.
#
# No secrets in this file: it is committed.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=northwind
