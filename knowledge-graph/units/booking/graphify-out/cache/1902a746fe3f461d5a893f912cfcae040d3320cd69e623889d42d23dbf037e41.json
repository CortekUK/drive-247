nfidence": "EXTRACTED", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L275", "weight": 1.0}], "raw_calls": [{"caller_nid": "use_customer_installments_usecustomerinstallmentplans", "callee": "useCustomerAuthStore", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L69"}, {"caller_nid": "use_customer_installments_usecustomerinstallmentplans", "callee": "useQuery", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L71"}, {"caller_nid": "use_customer_installments_useactiveinstallmentplans", "callee": "filter", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L146"}, {"caller_nid": "use_customer_installments_usenextinstallmentpayment", "callee": "(() => {\n    if (!plans || plans.length === 0) return null;\n\n    const today = new Date().toISOString().split('T')[0];\n    let earliest: { plan: InstallmentPlan; installment: ScheduledInstallment } | null = null;\n\n    for (const plan of plans) {\n      if (plan.status !== 'active' && plan.status !== 'overdue') continue;\n\n      for (const inst of plan.scheduled_installments) {\n        if (inst.status === 'scheduled' || inst.status === 'failed') {\n          if (!earliest || inst.due_date < earliest.installment.due_date) {\n            earliest = { plan, installment: inst };\n          }\n        }\n      }\n    }\n\n    return earliest;\n  })", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L157"}, {"caller_nid": "use_customer_installments_useinstallmentstats", "callee": "(() => {\n    if (!plans) return null;\n\n    const activePlans = plans.filter(\n      (p) => p.status === 'active' || p.status === 'overdue'\n    );\n    const completedPlans = plans.filter((p) => p.status === 'completed');\n\n    const totalPaid = plans.reduce((sum, p) => sum + (p.total_paid || 0), 0);\n    const totalRemaining = activePlans.reduce(\n      (sum, p) => sum + (p.total_installable_amount - (p.total_paid || 0)),\n      0\n    );\n\n    const today = new Date().toISOString().split('T')[0];\n    const overdueInstallments = plans.flatMap((p) =>\n      p.scheduled_installments.filter(\n        (i) => (i.status === 'scheduled' || i.status === 'failed') && i.due_date < today\n      )\n    );\n\n    const upcomingInstallments = plans.flatMap((p) =>\n      p.scheduled_installments.filter(\n        (i) => i.status === 'scheduled' && i.due_date >= today\n      )\n    );\n\n    return {\n      activePlans: activePlans.length,\n      completedPlans: completedPlans.length,\n      totalPaid,\n      totalRemaining,\n      overdueCount: overdueInstallments.length,\n      upcomingCount: upcomingInstallments.length,\n    };\n  })", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L185"}, {"caller_nid": "use_customer_installments_usecustomerpaymenthistory", "callee": "useCustomerAuthStore", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L227"}, {"caller_nid": "use_customer_installments_usecustomerpaymenthistory", "callee": "useQuery", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L229"}, {"caller_nid": "use_customer_installments_userentalinstallmentplan", "callee": "find", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-installments.ts", "source_location": "L278"}]}