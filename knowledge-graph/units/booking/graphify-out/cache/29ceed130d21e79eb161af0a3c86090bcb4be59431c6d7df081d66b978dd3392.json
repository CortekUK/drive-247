oks/use-customer-invoices.ts", "source_location": "L37"}, {"caller_nid": "use_customer_invoices_useinvoicestats", "callee": "(() => {\n    if (!invoices) return null;\n\n    const paidInvoices = invoices.filter(i => i.computed_status === 'paid');\n    const pendingInvoices = invoices.filter(i => i.computed_status === 'pending' || i.computed_status === 'partial');\n    const overdueInvoices = invoices.filter(i => i.computed_status === 'overdue');\n\n    const totalPaid = invoices.reduce((sum, i) => sum + i.paid_amount, 0);\n    const totalDue = invoices.reduce((sum, i) => {\n      const remaining = i.total_amount - i.paid_amount;\n      return sum + (remaining > 0 ? remaining : 0);\n    }, 0);\n\n    return {\n      totalInvoices: invoices.length,\n      paidCount: paidInvoices.length,\n      pendingCount: pendingInvoices.length,\n      overdueCount: overdueInvoices.length,\n      totalPaid,\n      totalDue,\n    };\n  })", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-invoices.ts", "source_location": "L148"}, {"caller_nid": "use_customer_invoices_useinvoicebyid", "callee": "useCustomerAuthStore", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-invoices.ts", "source_location": "L175"}, {"caller_nid": "use_customer_invoices_useinvoicebyid", "callee": "useQuery", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/booking/src/hooks/use-customer-invoices.ts", "source_location": "L177"}]}