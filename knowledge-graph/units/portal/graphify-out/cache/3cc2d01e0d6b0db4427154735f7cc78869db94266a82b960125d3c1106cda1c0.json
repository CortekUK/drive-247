rl };\n                setLogoData(next);\n                onSaveLogo(next);\n              }", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/portal/src/components/website-content/site-settings-editor.tsx", "source_location": "L104"}, {"caller_nid": "site_settings_editor_sitesettingseditor", "callee": "setLogoData", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/portal/src/components/website-content/site-settings-editor.tsx", "source_location": "L117"}, {"caller_nid": "site_settings_editor_sitesettingseditor", "callee": "Favicon", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/portal/src/components/website-content/site-settings-editor.tsx", "source_location": "L124"}, {"caller_nid": "site_settings_editor_sitesettingseditor", "callee": "Number", "source_file": "/home/haseeb-raza/Desktop/drive-247/apps/portal/src/components/website-content/site-settings-editor.tsx", "source_location": "L162"}]}