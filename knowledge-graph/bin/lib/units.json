{
  "_comment": "Single source of truth for how the drive-247 monorepo is partitioned into graph units. Every stage of the pipeline (detect, extract, namespace, link, merge) reads this file. Add a unit here and the whole pipeline picks it up.",
  "repo_root": "/home/haseeb-raza/Desktop/drive-247",
  "units": [
    {
      "name": "portal",
      "label": "Portal - multi-tenant operator admin",
      "paths": ["apps/portal"],
      "extractor": "graphify",
      "kind": "nextjs-app"
    },
    {
      "name": "booking",
      "label": "Booking - customer booking + customer portal",
      "paths": ["apps/booking"],
      "extractor": "graphify",
      "kind": "nextjs-app"
    },
    {
      "name": "admin",
      "label": "Admin - super-admin dashboard",
      "paths": ["apps/admin"],
      "extractor": "graphify",
      "kind": "nextjs-app"
    },
    {
      "name": "web",
      "label": "Web - marketing site",
      "paths": ["apps/web"],
      "extractor": "graphify",
      "kind": "nextjs-app"
    },
    {
      "name": "bonzah",
      "label": "Bonzah - insurance tenant app",
      "paths": ["apps/bonzah"],
      "extractor": "graphify",
      "kind": "nextjs-app"
    },
    {
      "name": "edge-functions",
      "label": "Edge Functions - Supabase Deno backend",
      "paths": ["supabase/functions"],
      "extractor": "graphify",
      "kind": "deno-functions"
    },
    {
      "name": "database",
      "label": "Database - schema, migrations, RLS",
      "paths": ["supabase/migrations", "docs/GMT_HOLD_SCHEMA.sql", "docs/INSHUR_SCHEMA.sql", "scripts/cleanup-temp-customers.sql", "MANUAL_MIGRATION.sql"],
      "extractor": "sql",
      "kind": "sql-migrations"
    },
    {
      "name": "docs",
      "label": "Docs - specs, plans, audits",
      "paths": ["docs", "CLAUDE.md"],
      "extractor": "graphify",
      "kind": "documents"
    },
    {
      "name": "scripts",
      "label": "Scripts - ops, seeding, deployment",
      "paths": ["scripts", "apply-migration.js", "apply-migration-now.js", "check-rental.js", "check-schema.js", "drive-booking.mjs", "execute-migration-curl.js", "force-migration.js", "run-migration-api.js", "test-veriff-api.js"],
      "extractor": "graphify",
      "kind": "ops-scripts"
    }
  ]
}
