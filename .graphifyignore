# graphify corpus exclusions for the drive-247 monorepo.
# Patterns match any path component (fnmatch), relative to the scan root
# AND to this file's directory, so one file at the repo root governs every
# per-unit scan under knowledge-graph/.

# --- build output / caches (regenerated, never source) ---
.next
.turbo
.vercel
node_modules
*.tsbuildinfo
next-env.d.ts

# --- the knowledge graph's own output (never ingest ourselves) ---
knowledge-graph
graphify-out

# --- dead / duplicated trees ---
# v2/ is a stale duplicated build scaffold: 1094 files, exactly one of which
# is real source (next-env.d.ts). Ingesting it would double every web-app node.
v2

# --- gitignored scratch space, not part of the product ---
helper-folder
quality-assurance
.claude

# --- binary assets: logos and icons carry no architectural signal, and each
#     image would otherwise consume a separate vision agent ---
public
logos

# --- lockfiles ---
bun.lockb
package-lock.json
