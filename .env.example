# ================================
# SELF-SERVE SIGNUP (apps/web -> supabase/functions/signup-*)
# ================================

# SaaS billing for self-serve signups runs on the UAE platform Stripe account —
# the same account every new tenant is billed on (tenants.subscription_account
# DEFAULTs to 'uae'). These SECRET keys already exist for the UAE migration;
# they are listed here because signup-payment-intent hard-requires them and
# throws a named error when either is absent.
STRIPE_UAE_TEST_SECRET_KEY=sk_test_...
STRIPE_UAE_LIVE_SECRET_KEY=sk_live_...

# NEW. Inline payment needs a publishable key in the browser, and there is no
# NEXT_PUBLIC one for the UAE account (NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY above
# is the BOOKING app's legacy UK key and will NOT work against a UAE
# PaymentIntent). signup-payment-intent returns the right key to the browser, so
# apps/web needs no Stripe variable of its own. If these are unset the signup
# dialog shows "Signup is temporarily unavailable" instead of a blank card form.
STRIPE_UAE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_UAE_LIVE_PUBLISHABLE_KEY=pk_live_...

# 'live' (default) or 'test'. 'test' bills on the UAE TEST account AND provisions
# tenant_type='test' tenants (which also get boldsign_mode='test'), so the whole
# flow can be rehearsed end to end without taking real money or creating a tenant
# that shows up in the production onboarding digest.
SIGNUP_STRIPE_MODE=live

# Optional. 'true' makes signup-provision mint a Supabase magic link so the new
# owner lands in their portal already signed in. REQUIRES
# https://*.portal.drive-247.com/** in the Supabase Auth redirect allow-list
# (Dashboard -> Authentication -> URL Configuration) — without it the link is
# rejected as otp_expired. Default 'false': the owner lands on their portal login
# page with the email pre-filled and signs in with the password they just chose,
# which needs no configuration anywhere and cannot silently break.
SIGNUP_PORTAL_MAGICLINK=false

# Public marketing origin. Only used to build the Stripe confirmPayment
# return_url fallback (card-only payments never actually redirect).
SIGNUP_PUBLIC_ORIGIN=https://drive-247.com