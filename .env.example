# ================================
# SHARED ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# ================================

# Supabase Configuration (ALL APPS)
NEXT_PUBLIC_SUPABASE_URL=https://hviqoaokxvlancmftwuo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PROJECT_ID=hviqoaokxvlancmftwuo

# Service Role Key (ADMIN SCRIPTS ONLY - Keep secret!)
# Get this from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe (BOOKING APP ONLY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Super Admin (ADMIN APP ONLY)
NEXT_PUBLIC_ENABLE_SUPER_ADMIN=true

# AWS Configuration (EDGE FUNCTIONS)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your-aws-secret-here
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@drive-247.com
ADMIN_EMAIL=admin@drive-247.com

# Resend (EDGE FUNCTIONS — primary email transport, replaces AWS SES)
# Get this from: https://resend.com/api-keys
# Set on Supabase: supabase secrets set RESEND_API_KEY=re_xxx --project-ref hviqoaokxvlancmftwuo


# OpenAI (EDGE FUNCTIONS — used by ai-suggest-next-action, ai-rank-matches,
# ai-extract-from-conversation, ai-draft-message, generate-review-summary)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_KEY_FALLBACK=sk-your-openai-fallback-key-here

# Custom auth email hook secret (EDGE FUNCTIONS — custom-auth-email)
SEND_EMAIL_HOOK_SECRET=your-supabase-auth-hook-secret-here

# Vercel/Deployment
NEXT_PUBLIC_SITE_URL=https://drive-247.com

# Strategy-call confirmation funnel
# Confirm these values with the GHL admin before enabling the v2 funnel.
NEXT_PUBLIC_GHL_BOOKING_URL=https://api.leadconnectorhq.com/widget/booking/your-calendar-id
NEXT_PUBLIC_GHL_ALLOWED_ORIGINS=https://api.leadconnectorhq.com
# Optional provider-confirmed custom query field for the non-secret session UUID.
NEXT_PUBLIC_GHL_SESSION_QUERY_PARAM=
STRATEGY_CALL_CONFIRMATION_V2=false
# Server-only. Generate independent high-entropy values in each environment.
# Optional. When unset, it is derived from SUPABASE_SERVICE_ROLE_KEY, which this
# feature already requires — so a deploy only has to get that one right. Set an
# explicit value if you ever need to rotate the pepper without rotating the key.
STRATEGY_CALL_SESSION_PEPPER=replace-with-a-random-server-only-value
# REQUIRED for the strategy-call funnel. The web app did not use this before the
# funnel shipped, so an existing deployment will not already have it set.
SUPABASE_SERVICE_ROLE_KEY=
# Current Marketplace mode: verifies raw-body X-GHL-Signature with Ed25519.
# The official public key is built in; override only if GHL formally rotates it.
GHL_STRATEGY_CALL_WEBHOOK_MODE=marketplace
GHL_ED25519_PUBLIC_KEY=
# Fail-closed scope and URL allow-lists. Staging and production IDs differ.
GHL_STRATEGY_CALL_ALLOWED_LOCATION_IDS=your-ghl-location-id
GHL_STRATEGY_CALL_ALLOWED_CALENDAR_IDS=your-strategy-call-calendar-id
GHL_STRATEGY_CALL_ALLOWED_URL_HOSTS=leadconnectorhq.com,msgsndr.com
# Required for Marketplace AppointmentCreate unless a verified staging fixture
# proves that the widget echoes strategy_call_session_id or an email value.
GHL_PRIVATE_INTEGRATION_TOKEN=
# Compatibility mode is separate and opt-in. Only a deliberately configured
# GHL Workflow custom webhook may use this mode/header; it is never a signature
# fallback for Marketplace requests.
# GHL_STRATEGY_CALL_WEBHOOK_MODE=workflow_shared_secret
GHL_STRATEGY_CALL_WORKFLOW_SECRET=
STRATEGY_CALL_CONFIRMATION_URL=https://drive-247.com/strategy-call/confirmation
STRATEGY_CALL_FROM_EMAIL=support@drive-247.com
STRATEGY_CALL_REPLY_TO_EMAIL=support@drive-247.com
STRATEGY_CALL_EMAIL_LOGO_URL=https://drive-247.com/logo-light.png

# Stripe Metered Billing (E-Sign Usage — separate price per mode)
STRIPE_ESIGN_METERED_PRICE_ID_TEST=price_test_xxx
STRIPE_ESIGN_METERED_PRICE_ID_LIVE=price_live_xxx

# BoldSign (eSign - PORTAL & BOOKING APPS)
BOLDSIGN_TEST_API_KEY=your-boldsign-sandbox-api-key
BOLDSIGN_LIVE_API_KEY=your-boldsign-production-api-key
BOLDSIGN_BASE_URL=https://api.boldsign.com

# Optional: Veriff (BOOKING APP)
NEXT_PUBLIC_VERIFF_API_KEY=e87ea632-3b71-468a-a4b8-a0f2a7598e2f
VERIFF_API_SECRET=your-veriff-secret-key-here
OPENROUTER_API_KEY=your_openrouter_api_key

# Modives CheckMyDriver (EDGE FUNCTIONS — staging values, swap for prod)
MODIVES_BASE_URL=https://api-stgext1.modives.com
MODIVES_CLIENT_ID=your-modives-client-id
MODIVES_CLIENT_SECRET=your-modives-client-secret
MODIVES_SUBSCRIPTION_KEY=your-modives-apim-subscription-key
MODIVES_WEBHOOK_SECRET=your-modives-webhook-secret
MODIVES_AUTH_KEY=your-modives-auth-key
# Public origin of the Drive247 marketing site, which serves the CANONICAL
# platform legal documents (/terms and /privacy). The portal links its consent
# checkboxes here and 307s its own retired /terms and /privacy-policy routes to
# it. Leave unset in production; point at http://localhost:3002 to exercise the
# consent flow against a local marketing build.
NEXT_PUBLIC_MARKETING_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Finance Sync — Xero + Zoho Books
# Set these in Supabase project secrets (`supabase secrets set`), NOT here.
# This file is committed — it must never carry a real client secret.
# ─────────────────────────────────────────────────────────────────────────────

# Xero — register your app at https://developer.xero.com → My Apps → New app
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/xero-oauth-callback
XERO_WEBHOOK_KEY=                                 # Phase 2+ (webhook ingestion)

# Zoho Books — register at https://api-console.zoho.com → Add Client → Server-based
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/zoho-oauth-callback
ZOHO_WEBHOOK_KEY=                                 # Phase 2+ (webhook ingestion)

# Shared sync-worker tuning. Defaults live in the worker; override only if the
# provider raises/lowers your app's published limits.
ACCOUNTING_SYNC_BATCH_SIZE=40                     # sync rows claimed per cron tick
ACCOUNTING_SYNC_RATE_LIMIT_XERO=55                # Xero hard limit is 60 calls/min
ACCOUNTING_SYNC_RATE_LIMIT_ZOHO=90                # Zoho hard limit is 100 calls/min
ACCOUNTING_SYNC_DEAD_LETTER_AFTER=5               # attempts before dead-letter
ACCOUNTING_SYNC_CLAIM_TIMEOUT_MINUTES=15          # reclaim rows stuck mid-flight
